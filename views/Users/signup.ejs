<% layout("/layouts/boilerplate") %>

<div class="form-page-wrapper">
  <div class="form-card">
    <div class="form-card-header">
      <i class="fa-regular fa-compass brand-icon-lg"></i>
      <h2>Join Wanderlust</h2>
      <p>Create your account and start exploring</p>
    </div>

    <form action="/signup" method="POST" class="needs-validation" novalidate id="signup-form">

      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <div class="input-group-icon">
          <i class="fa-regular fa-user input-icon"></i>
          <input
            type="text"
            name="username"
            id="username"
            placeholder="Choose a username"
            class="form-control"
            required
            autocomplete="username"
          />
          <div class="valid-feedback">Username looks good!</div>
          <div class="invalid-feedback">Please choose a username.</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="email" class="form-label">Email Address</label>
        <div class="input-group-icon">
          <i class="fa-regular fa-envelope input-icon"></i>
          <input
            type="email"
            name="email"
            id="email"
            placeholder="you@example.com"
            class="form-control"
            required
            autocomplete="email"
          />
          <div class="invalid-feedback">Please enter a valid email address.</div>
        </div>
      </div>

      <div class="mb-4">
        <label for="password" class="form-label">Password</label>
        <div class="input-group-icon">
          <i class="fa-solid fa-lock input-icon"></i>
          <input
            type="password"
            name="password"
            id="password"
            placeholder="Create a strong password"
            class="form-control"
            required
            autocomplete="new-password"
          />
          <div class="invalid-feedback">Please enter a password.</div>
        </div>
      </div>

      <button class="btn btn-brand" id="signup-submit-btn" type="submit">
        <i class="fa-solid fa-user-plus me-1"></i> Create Account
      </button>
    </form>

    <div class="form-switch-link">
      Already have an account? <a href="/login">Log in</a>
    </div>
  </div>
</div>