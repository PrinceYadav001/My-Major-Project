<nav class="navbar navbar-expand-md sticky-top">
  <div class="container-fluid px-4">

    <!-- Brand -->
    <a class="navbar-brand" href="/listings">
      <i class="fa-regular fa-compass brand-icon"></i>
      <span class="brand-text">Wanderlust</span>
    </a>

    <!-- Mobile toggler -->
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
      data-bs-target="#navbarMain" aria-controls="navbarMain"
      aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMain">

    <!-- Search — only on listings index & search results pages -->
    <% const onListingsIndex = currPath === '/listings' || currPath.startsWith('/listings?'); %>
    <% if (onListingsIndex) { %>
    <div class="mx-auto my-2 my-md-0">
      <form class="search-form" role="search" action="/listings" method="GET">
        <i class="fa-solid fa-magnifying-glass text-muted me-2" style="font-size:0.85rem;"></i>
        <input
          class="search-inp"
          type="search"
          name="q"
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          placeholder="Search destinations…"
          aria-label="Search destinations"
        />
        <button class="search-btn" type="submit" id="search-submit-btn">
          Search
        </button>
      </form>
    </div>
    <% } %>

      <!-- Right-side nav -->
      <div class="navbar-nav ms-auto align-items-center gap-1 my-2 my-md-0">
        <a class="nav-link" href="/listings">Explore</a>
        <a class="nav-link" href="/listings/new">Airbnb your home</a>

        <% if (!currUser) { %>
          <a class="btn-airbnb-link ms-2" href="/signup" id="signup-nav-btn">
            <i class="fa-regular fa-user"></i> Sign Up
          </a>
          <a class="btn-airbnb-link" href="/login" id="login-nav-btn">
            Log In
          </a>
        <% } else { %>
          <span class="nav-link text-muted" style="font-size:0.85rem;">
            <i class="fa-solid fa-circle-user me-1" style="color:var(--brand)"></i>
            <%= currUser.username %>
          </span>
          <a class="btn-airbnb-link" href="/logout" id="logout-nav-btn">
            <i class="fa-solid fa-arrow-right-from-bracket"></i> Log out
          </a>
        <% } %>
      </div>

    </div>
  </div>
</nav>

<script>
  // Add scrolled class for shadow effect
  window.addEventListener('scroll', () => {
    const nav = document.querySelector('.navbar');
    if (window.scrollY > 10) nav.classList.add('navbar-scrolled');
    else nav.classList.remove('navbar-scrolled');
  });
</script>