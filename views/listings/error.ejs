<% layout("/layouts/boilerplate") %>

<div class="error-page">
  <div class="error-icon">
    <i class="fa-solid fa-triangle-exclamation"></i>
  </div>
  <div class="error-code"><%= err.status || 500 %></div>
  <h1 class="error-message"><%= err.message %></h1>
  <p class="error-sub">Something went wrong. Don't worry, let's get you back on track.</p>
  <div class="d-flex gap-3 justify-content-center">
    <a href="javascript:history.back()" class="btn-airbnb-link" id="go-back-btn">
      <i class="fa-solid fa-arrow-left me-1"></i> Go Back
    </a>
    <a href="/listings" class="btn add-btn btn" id="go-home-btn" style="width:auto;">
      <i class="fa-solid fa-house me-1"></i> Go Home
    </a>
  </div>
</div>