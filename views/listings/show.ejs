<% layout('/layouts/boilerplate') %>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="show-wrapper">

  <!-- Title -->
  <h1 class="show-title"><%= listing.title %></h1>

  <!-- Owner badge -->
  <div class="show-owner-badge">
    <i class="fa-solid fa-crown"></i>
    Hosted by <strong><%= listing.owner ? listing.owner.username : 'Wanderlust Host' %></strong>
  </div>

  <!-- Hero image -->
  <img
    src="<%= listing.image.url %>"
    class="show-hero-img"
    alt="<%= listing.title %>"
  >

  <hr class="show-divider">

  <!-- Description -->
  <p class="show-description"><%= listing.description %></p>

  <!-- Meta info pills -->
  <div class="show-meta">
    <div class="show-meta-item">
      <i class="fa-solid fa-location-dot"></i>
      <%= listing.location %>
    </div>
    <div class="show-meta-item">
      <i class="fa-solid fa-globe"></i>
      <%= listing.country %>
    </div>
  </div>

  <!-- Price -->
  <div class="price-badge mb-3">
    &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %>
    <span>/ night</span>
  </div>

  <!-- Edit / Delete (owner only) -->
  <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
    <div class="show-action-btns mb-3">
      <a href="/listings/<%= listing._id %>/edit" class="btn-edit" id="edit-listing-btn">
        <i class="fa-solid fa-pen-to-square me-1"></i> Edit
      </a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE"
            onsubmit="return confirm('Are you sure you want to delete this listing?');"
            style="display:inline;">
        <button class="btn-delete-outline" id="delete-listing-btn" type="submit">
          <i class="fa-solid fa-trash me-1"></i> Delete
        </button>
      </form>
    </div>
  <% } %>

  <hr class="show-divider">

  <!-- ── Review Form ── -->
  <h2 class="section-title">Leave a Review</h2>
  <div class="review-form-card mb-4">
    <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
      <div class="mb-3">
        <label for="rating" class="form-label">Your Rating</label>
        <fieldset class="starability-slot">
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
            value="1" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>
      <div class="mb-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea name="review[comment]" id="comment" cols="30" rows="4"
          class="form-control" required placeholder="Share your experience…"></textarea>
        <div class="invalid-feedback">Please add some comments for your review.</div>
      </div>
      <button class="btn add-btn" id="submit-review-btn" type="submit">
        <i class="fa-solid fa-paper-plane me-1"></i> Submit Review
      </button>
    </form>
  </div>

  <!-- ── All Reviews ── -->
  <hr class="show-divider">
  <h2 class="section-title">All Reviews</h2>

  <% if (listing.reviews.length === 0) { %>
    <p class="no-reviews"><i class="fa-regular fa-comment me-2"></i>No reviews yet — be the first!</p>
  <% } else { %>
    <div class="reviews-grid">
      <% for (let review of listing.reviews) { %>
        <div class="review-card">
          <div class="review-header">
            <div class="review-avatar">
              <%= review.author.username.charAt(0).toUpperCase() %>
            </div>
            <div>
              <div class="review-author">@<%= review.author.username %></div>
              <p class="starability-result" data-rating="<%= review.rating %>" style="margin:0;"></p>
            </div>
          </div>
          <p class="review-comment"><%= review.comment %></p>

          <% if (currUser && currUser._id.equals(review.author._id)) { %>
            <form
              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
              method="POST" class="mt-2">
              <button class="btn btn-sm btn-outline-danger" id="delete-review-<%= review._id %>" type="submit">
                <i class="fa-solid fa-trash me-1"></i> Delete
              </button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- ── Map ── -->
  <div class="map-section">
    <hr class="show-divider">
    <h2 class="section-title"><i class="fa-solid fa-map-location-dot me-2" style="color:var(--brand)"></i>Where you'll be</h2>
    <div id="map"></div>
  </div>

</div>

<script src="/js/map.js"></script>